# Twilio Configuration
# Get these values from your Twilio dashboard: https://www.twilio.com/console
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# This is the Twilio phone number you are using for WhatsApp.
# For the sandbox, it is typically 'whatsapp:+14155238886'
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
